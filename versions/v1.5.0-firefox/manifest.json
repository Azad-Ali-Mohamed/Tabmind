{
  "manifest_version": 3,
  "name": "Smart Tab Manager",
  "version": "1.5.0",
  "description": "Adaptive tab memory management using recency, frequency, focus, and active-time scoring.",
  "permissions": ["tabs", "storage", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Smart Tab Manager",
    "default_popup": "popup.html",
    "default_icon": { "128": "icons/icon128.png" }
  },
  "icons": { "128": "icons/icon128.png" }
}
